   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/NocturneTelevision/Materials/M_NocturneTelevisionDistorted.M_NocturneTelevisionDistorted:MaterialExpressionCustom_2'"
      Code="float strength = saturate(DistortionEnabled) * saturate(DistortionAmount);\nfloat frame = floor(ElapsedTime * 30.0);\nfloat row = floor(UV.y * max(ScanlineDensity, 1.0));\nfloat jitter = frac(sin(row * 12.9898 + frame * 78.233) * 43758.5453) * 2.0 - 1.0;\nfloat2 warped = UV;\nwarped.x = saturate(UV.x + strength * (jitter * HorizontalJitter + 1.0 * ChromaticAberration));\nwarped.y = frac(UV.y + strength * ElapsedTime * VerticalRollSpeed);\nreturn strength > 0.0 ? warped : UV;\n"
      OutputType=CMOT_Float2
      Description="Red video sampling coordinates"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'M_NocturneTelevisionDistorted:MaterialExpressionTextureCoordinate_1'"))
      Inputs(1)=(InputName="ElapsedTime")
      Inputs(2)=(InputName="DistortionEnabled")
      Inputs(3)=(InputName="DistortionAmount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_NocturneTelevisionDistorted:MaterialExpressionScalarParameter_6'"))
      Inputs(4)=(InputName="ScanlineDensity",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_NocturneTelevisionDistorted:MaterialExpressionScalarParameter_10'"))
      Inputs(5)=(InputName="HorizontalJitter",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_NocturneTelevisionDistorted:MaterialExpressionScalarParameter_16'"))
      Inputs(6)=(InputName="VerticalRollSpeed")
      Inputs(7)=(InputName="ChromaticAberration",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_NocturneTelevisionDistorted:MaterialExpressionScalarParameter_20'"))
      MaterialExpressionEditorX=-900
      MaterialExpressionEditorY=-680
      MaterialExpressionGuid=A476709B492AAEC08F46D6AAA59B03DD
      Material="/Script/Engine.Material'M_NocturneTelevisionDistorted'"
   End Object
   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/NocturneTelevision/Materials/M_NocturneTelevisionDistorted.M_NocturneTelevisionDistorted:MaterialExpressionCustom_3'"
      Code="float strength = saturate(DistortionEnabled) * saturate(DistortionAmount);\nfloat frame = floor(ElapsedTime * 30.0);\nfloat row = floor(UV.y * max(ScanlineDensity, 1.0));\nfloat jitter = frac(sin(row * 12.9898 + frame * 78.233) * 43758.5453) * 2.0 - 1.0;\nfloat2 warped = UV;\nwarped.x = saturate(UV.x + strength * (jitter * HorizontalJitter + 0.0 * ChromaticAberration));\nwarped.y = frac(UV.y + strength * ElapsedTime * VerticalRollSpeed);\nreturn strength > 0.0 ? warped : UV;\n"
